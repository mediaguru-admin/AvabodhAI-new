# Extracted chart/table crops from ingested documents - CUSTOMER CONTENT,
# regenerated by re-ingesting. Never commit.
visual_crops/

# Generated by FastAPI from the code itself - the running app serves the
# real thing at /openapi.json. A committed copy goes stale silently (this
# one drifted within two days) and a spec that lies is worse than none.
# If the contract-diff-in-PR benefit is wanted later, regenerate it in CI
# and fail the build on a mismatch rather than committing it by hand.
openapi.json
