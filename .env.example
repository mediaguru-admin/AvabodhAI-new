# AvabodhAI — environment configuration reference.
#
# Copy this to .env (repo root) and fill in the MANDATORY section below.
# Everything under OPTIONAL already has a working default — only change
# a line there if you actually mean to.
#
# This file is loaded by config/settings.py. It is NOT baked into the
# Docker image and is NEVER read inside a deployed container — a real
# deployment sets these as actual environment variables, one full set
# per environment (dev/staging/prod each get their own values; never
# copy one environment's values into another).


# ═══════════════════════════════════════════════════════════════════════
# MANDATORY — the app will not run correctly (or will be unsafe) without
# a real value here. Every line below is either required to start at
# all, or ships with a placeholder that is public knowledge and MUST be
# replaced before anything real touches this deployment.
# ═══════════════════════════════════════════════════════════════════════

# Your OpenAI key. Everything smart the app does — reading a document,
# writing its summary, answering a chat question, describing a chart
# image — is an OpenAI call. The app checks for this at startup and
# refuses to boot without it.
OPENAI_API_KEY=

# ── Postgres: where documents/chats are recorded ────────────────────────
# This must be a real Postgres server you set up yourself — not something
# this app's Docker Compose creates for you (see scripts/init_schema.py).
# It must also be its OWN database, never shared with clariona-core's.
#
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD below are your
# Postgres ADMIN login. The app only uses this once, at startup, to set
# everything up (create tables, create the limited-access account below,
# turn on per-tenant data isolation). It is never used to answer a real
# request.
DB_HOST=
DB_PORT=5432
DB_NAME=avabodh
DB_USER=postgres
DB_PASSWORD=

# APP_DB_PASSWORD is the password for a SECOND, limited-access database
# account that the app actually uses for every real request. This one
# matters: Postgres has a rule that an admin account can always see every
# row, no matter what access rules you set up — so if the app used your
# admin login above for real traffic, one tenant's documents could leak
# into another tenant's results. Using this separate, limited account is
# what makes tenant data isolation actually work. It's created for you
# automatically the first time the app starts.
# Production: MUST change — the value below is a public, well-known
# placeholder anyone reading this file already knows.
APP_DB_PASSWORD=CHANGE-ME-app-role-password

# ── Qdrant: where document text is made searchable ──────────────────────
# Your own Qdrant server (the search index this app queries when you ask
# it a question). Same rule as Postgres above: you provision this
# yourself, it is not something Docker Compose spins up for you, and it
# must be a separate instance from anything clariona-core uses. Set up
# with scripts/init_qdrant.py.
# Without this set correctly, uploads will look like they succeeded but
# will never actually finish processing — nothing will ever show an
# error, the document just never becomes searchable.
QDRANT_URL=

# A secret string used to sign document preview links, so a link can't
# be guessed or tampered with. The built-in default is a publicly known
# placeholder written directly in this repo's source code — if you don't
# change it, anyone who has read this code can forge a working preview
# link to any document.
# Production: MUST change — set it to a long, random string.
SECRET_KEY=CHANGE-ME-to-a-long-random-value


# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL — every line below has a working default. Change one only if
# you have a specific reason to.
# ═══════════════════════════════════════════════════════════════════════

# ── Postgres tuning ──────────────────────────────────────────────────────
# The username for the limited-access account described above (paired
# with APP_DB_PASSWORD in the MANDATORY section). Only rename it if you
# want a different name for that account.
# Production: fine to leave as-is.
APP_DB_USER=avabodh_app
# How many database connections the app keeps open and ready (DB_POOL_SIZE),
# how many extra it's allowed to open under heavy load (DB_MAX_OVERFLOW),
# and how many seconds a request will wait for a free connection before
# giving up (DB_POOL_TIMEOUT).
# Production: raise DB_POOL_SIZE if you're running under real concurrent
# traffic and see connection-wait errors; otherwise leave as-is.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Qdrant tuning ─────────────────────────────────────────────────────────
# Only needed if your Qdrant server requires a login key to connect. A
# self-hosted Qdrant with no authentication (a common local/dev setup)
# leaves this blank.
# Production: set this if your Qdrant server has authentication turned on.
QDRANT_API_KEY=
# Names of the three "collections" (like table names, but for Qdrant) this
# app stores data in: document chunks, chat message embeddings (semantic
# recall), and document-summary embeddings (document shortlisting). Only
# change these if you specifically want to run multiple separate AvabodhAI
# deployments against the same Qdrant server.
# Production: fine to leave as-is.
QDRANT_COLLECTION=avabodh_chunks
QDRANT_CHAT_COLLECTION=avabodh_chat_messages
QDRANT_DOC_SUMMARY_COLLECTION=avabodh_document_summaries
# If a batch of chunks fails to upsert into Qdrant, how many times to
# retry it before declaring the whole document/upload failed.
# Production: fine to leave as-is.
QDRANT_UPSERT_MAX_RETRIES=5

# ── AI models used for ingestion, chat, and search ───────────────────────
# The model used to summarise each individual chunk of a document while
# it's being processed (MAP_MODEL), and the model used to combine those
# chunk summaries into the document's final overall summary (REDUCE_MODEL).
# Production: fine to leave as-is; a cheaper/faster model is fine here
# since this runs automatically in the background, not in front of a user.
MAP_MODEL=gpt-4o-mini
REDUCE_MODEL=gpt-4o-mini
# The model that actually answers a user's chat question. Kept separate
# from MAP_MODEL above because answers now include real chart/table
# images, and the cheaper model reads those noticeably worse.
# Production: fine to leave as-is; only change if you want a
# cheaper/faster (but less accurate) chat experience.
CHAT_MODEL=gpt-4o-mini
# How "creative" vs. exact the chat model's answers are, on a 0-1 scale.
# Kept low here because answers need to quote exact figures correctly,
# not vary creatively between two askings of the same question.
# Production: fine to leave as-is.
CHAT_TEMPERATURE=0.1
# The model that converts document text into the numeric form ("vectors")
# that makes searching possible.
# Production: fine to leave as-is. If you ever DO change this, you must
# also update EMBEDDING_DIMENSIONS below to match, and you'll need to
# rebuild your Qdrant collections from scratch — old and new vectors
# aren't compatible with each other.
EMBEDDING_MODEL=text-embedding-3-small
# The size of the numeric vector EMBEDDING_MODEL above produces
# (text-embedding-3-small = 1536, text-embedding-3-large = 3072). This
# has to exactly match whatever EMBEDDING_MODEL actually outputs.
# Production: only change this together with EMBEDDING_MODEL above, and
# only before you've ingested any real documents — changing it afterward
# means every existing document has to be re-processed from scratch.
EMBEDDING_DIMENSIONS=1536
# How many chunks get sent to OpenAI in one batch when generating those
# vectors. A purely internal performance knob.
# Production: fine to leave as-is.
EMBEDDING_BATCH_SIZE=100
# If a batch of embeddings fails (rate limit, network blip), how many
# times to retry it before giving up on the whole document. Exhausting
# retries fails the document rather than skipping the batch and
# continuing — a skipped batch means those chunks are silently missing
# from search results with no indication anything went wrong.
# Production: fine to leave as-is.
EMBEDDING_MAX_RETRIES=2
# The model used to describe images, charts, and diagrams found inside a
# document, and to read images a user attaches to a chat question.
# Production: fine to leave as-is.
VISION_MODEL=gpt-4o
# Length limits (in "tokens", roughly = words) for the two summarisation
# calls described above (MAP_MODEL / REDUCE_MODEL).
# Production: fine to leave as-is.
MAP_MAX_TOKENS=512
REDUCE_MAX_TOKENS=1024
# How "creative" vs. exact the background ingestion/summarisation calls
# are. Kept at 0 (fully exact/deterministic) since this is extracting
# facts from a document, not writing something original.
# Production: fine to leave as-is.
LLM_TEMPERATURE=0.0
# How long (seconds) the app waits for OpenAI to respond before giving up
# on one call, and how many times it retries a failed call.
# Production: fine to leave as-is; raise the timeout if you're processing
# unusually large documents and seeing timeout errors.
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3
# Chat answers are user-facing, so they fail fast instead of using the
# longer ingestion budget below. 45s x 1 retry caps a chat turn's LLM time
# at ~90s; the ingestion timeout would allow ~8 minutes, which reads as
# "broken" rather than "slow" when somebody is watching a spinner.
CHAT_REQUEST_TIMEOUT=45
CHAT_MAX_RETRIES=1

# The model used for keyword-style search (catches exact words/phrases
# that a pure "meaning-based" search can miss), and the model used to
# re-sort search results by relevance before they're shown. Both run
# directly on this machine (no API key, no per-call cost) and download
# themselves automatically the first time they're used (~100MB total).
# Production: fine to leave as-is.
SPARSE_MODEL=prithivida/Splade_PP_en_v1
# How many document chunks the keyword-search model processes at once.
# Lower this if the app crashes with an out-of-memory error while
# processing a large document; raise it for speed on a machine with more
# memory to spare.
# Production: fine to leave as-is unless you hit a memory crash.
SPARSE_BATCH_SIZE=8
# NOTE: must be a model the re-sorting library actually supports.
# "bge-reranker-v2-m3" is NOT supported — pointing at it makes re-sorting
# silently do nothing instead of raising an error. See config/settings.py.
# Production: fine to leave as-is.
RERANK_MODEL=BAAI/bge-reranker-base
# How many search results get pulled up for re-sorting before the best
# ones are picked. SEARCH_CANDIDATES is a fallback number; in practice
# the app looks at how many chunks the document actually has and uses the
# smaller of that or SEARCH_CANDIDATES_MAX. Re-sorting more results costs
# more CPU time, so raise these only on a machine with memory to spare.
# Production: fine to leave as-is unless search feels slow or misses
# obviously-relevant results in very large documents.
SEARCH_CANDIDATES=20
SEARCH_CANDIDATES_MAX=80
# Before searching individual chunks, the app first narrows to the most
# relevant documents (using each document's summary) — but only when the
# knowledge base actually has more documents than this number; a
# knowledge base with 5 or fewer documents never gets narrowed at all.
# Production: fine to leave as-is. Raise it if broad questions that
# genuinely need evidence from many documents at once seem to miss some.
DOC_SHORTLIST_LIMIT=5
# How much the final chunk selection favors variety (pulling from
# different documents/sections) over pure relevance, from 0 (variety
# only) to 1 (relevance only, ignores variety).
# Production: fine to leave as-is — this app prioritizes exact, correct
# figures over broad coverage, so this stays close to 1. Lower it only if
# you want broader-coverage answers and can tolerate less exact figures.
MMR_LAMBDA=1.0
# A relevance cutoff — search results scoring below this get dropped
# entirely instead of shown. Leave blank for no cutoff at all.
# Production: leave blank until you've watched real search results for a
# while and have a specific reason to filter out low-relevance ones.
SEARCH_SCORE_THRESHOLD=

# A free, locally-run fallback model, used automatically ONLY if
# OPENAI_API_KEY above is left blank AND a local Ollama server is found
# running at OLLAMA_BASE_URL. Not the normal path — remember the app
# won't even start without OPENAI_API_KEY set, per the MANDATORY section.
# Production: not used in a normal deployment; ignore this whole block
# unless you're specifically running an offline/no-OpenAI setup.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
GROQ_API_KEY=
LLM_PROVIDER=auto

# ── How documents get cut into pieces ────────────────────────────────────
# The largest and smallest a single "chunk" of a document is allowed to
# be, in characters. Chunks are the pieces search and chat actually work
# with — too big and search gets imprecise, too small and answers lose
# context.
# Production: fine to leave as-is.
MAX_CHUNK_SIZE=3000
MIN_CHUNK_SIZE=100
# When a section of text is too big and has to be force-split, this many
# characters from the end of one piece get repeated at the start of the
# next, so a sentence cut in half doesn't lose its context.
# Production: fine to leave as-is.
CHUNK_OVERLAP=200
# What language document summaries get written in.
# Production: change this if your documents/users are in a language
# other than English.
SUMMARY_LANGUAGE=English
# If a PDF page has fewer than this many characters of real, extractable
# text, any table found on it must have come from OCR (the page is
# vector-drawn or scanned) — so its extracted HTML isn't trusted and the
# table is read by GPT-4o Vision from the rendered crop instead. Lower
# this only if you're confident your PDFs have proper text layers.
TABLE_TEXT_LAYER_MIN_CHARS=200

# Conversation memory: how many turns (1 turn = 1 human + 1 AI message)
# stay verbatim in the prompt before aging out into the rolling summary.
MEMORY_WINDOW_SIZE=5
# How many semantically-relevant past messages (from anywhere in the
# thread, not just the recent window) get pulled in per turn.
MEMORY_SEMANTIC_RECALL_LIMIT=4
# Max tokens for the rolling-summary LLM call that folds in turns as they
# age out of the recency window.
MEMORY_SUMMARY_MAX_TOKENS=400
# How thoroughly PDFs get read. "hi_res" runs a real layout-reading model
# plus OCR as a fallback — accurate but slower. "fast" skips both and
# only works well on PDFs that already have a proper text layer (not
# scanned images).
# Production: leave as "hi_res" unless you specifically need faster,
# lower-accuracy processing and know your PDFs are all text-based.
UNSTRUCTURED_STRATEGY=hi_res

# ── Where files are kept on disk ─────────────────────────────────────────
# Folders on the server's local disk used as working space while
# processing uploads.
# Production: fine to leave as-is.
UPLOAD_DIR=./uploaded_files
DOCUMENTS_DIR=./documents

# ── Reading charts, diagrams, and images inside documents ────────────────
# The on/off switch for using AI vision to describe charts/diagrams found
# inside a document while it's being processed. Leaving this on (the
# default) is today's normal behavior. Turning it off saves the cost of
# those AI calls, but any chart or diagram in a document becomes
# permanently unsearchable and invisible to chat — it's simply skipped.
# Does NOT affect a user attaching their own image to a chat question —
# that always uses AI vision regardless of this setting.
# Production: leave on unless you specifically want to cut this cost and
# accept that charts/diagrams won't be searchable.
VISION_ENABLED=true
# The most images from a SINGLE document that are ever sent for AI
# description. Without a cap, one large document (or one page of a
# website crawl) could quietly trigger dozens or hundreds of paid AI
# calls. Extra images beyond this limit are just skipped, not failed —
# the rest of the document still processes normally.
# Production: fine to leave as-is; lower it if you're processing
# image-heavy documents and want to control cost.
MAX_IMAGES_PER_DOCUMENT=20
# Images smaller than this (in bytes) or with dimensions/worker settings
# outside these bounds are treated as decorative noise (icons, logos,
# spacers) and skipped rather than described.
# Production: fine to leave as-is.
IMAGE_MIN_SIZE_BYTES=5000
IMAGE_MAX_DIMENSION=1024
IMAGE_MAX_WORKERS=4
# Where cropped images of charts/diagrams/tables are saved on disk. These
# saved crops let the chat model look at the ACTUAL image again when
# answering a question, instead of relying only on a text description
# written once when the document was first processed.
# Production: fine to leave as-is.
VISUAL_CROPS_DIR=./visual_crops
# The most image crops that get attached to a single chat answer. Each
# one is a real, fairly expensive AI vision call, so this caps cost even
# if a question would otherwise pull in many relevant images.
# Production: fine to leave as-is.
MAX_ATTACHED_CROPS=6
# How many sources are shown per chat answer (the citation list shown to
# the user, not what the LLM answers from — retrieval still uses the
# full top_k for that; this only trims what gets displayed afterward).
# Production: fine to leave as-is.
MAX_SOURCES_RETURNED=3

# ── Document preview links / public address ───────────────────────────────
# How long (in seconds) a document preview link stays valid before it
# expires. Left blank, links never expire — a deliberate default, but
# worth knowing: a leaked link works forever unless you set this.
# Production: consider setting a value if document confidentiality
# matters for your use case.
FILE_LINK_TTL_SECONDS=
# The public web address people actually reach THIS deployment at. Every
# document preview link is built starting with this address. Leave it
# blank and the app guesses the address from the incoming request —
# which works fine for direct local access, but is WRONG the moment
# there's a reverse proxy or load balancer in front of the app, because
# then it guesses the app's internal address instead of the real public
# one, and every preview link becomes a dead link nobody outside the
# server can open.
#   local dev:   http://localhost:8000
#   staging:     https://dev.v2.clariona.ai
#   production:  https://v2.clariona.ai
# No trailing slash. Include https:// (or http://).
# Also: each environment needs its OWN SECRET_KEY (see MANDATORY section)
# — reusing one means a link issued by staging would also work in
# production.
# Production: MUST set this to your real public URL.
PUBLIC_BASE_URL=

# ── Core webhook (push ingestion status instead of Core polling) ────────
# Optional. When set, a status ping is sent to Core the instant a document
# reaches PROCESSING/READY/FAILED, instead of Core only finding out on its
# next poll. Leave blank and nothing changes — Core's existing poll loop
# is untouched and keeps working exactly as it does today; this is purely
# a latency improvement on top of it, not a replacement.
# Production: set this once Core's webhook-receiving endpoint exists and
# you know its URL. Until then, leave blank — the poll fallback covers you.
CORE_WEBHOOK_URL=
# Shared secret sent as the X-Webhook-Secret header on every ping, so Core
# can trust it actually came from this instance. Must match whatever Core
# is configured to expect from this Avabodh instance specifically.
# Production: MUST set to a real random value if CORE_WEBHOOK_URL is set —
# otherwise anyone who can reach Core's webhook endpoint could send fake
# status updates for any document.
CORE_WEBHOOK_SECRET=
# How long (seconds) to wait for Core to respond before giving up on one
# ping. Kept short on purpose — this runs inside the ingestion background
# task, so a slow/hung Core must never be able to stall ingestion itself.
# Production: fine to leave as-is.
CORE_WEBHOOK_TIMEOUT_SECONDS=5.0

# ── LLM execution log ──────────────────────────────────────────────────
# Every chat-completion / vision call is recorded in llm_execution_logs
# and readable via GET /llm-logs. Text fields are capped per field.
# Callers can identify themselves with an X-Client-ID header.
LLM_LOG_ENABLED=true
LLM_LOG_MAX_TEXT_CHARS=50000
# Optional: also publish each log as an llm.execution.logged.v1 event to
# Kafka (clariona-core consumes these into its own llm_execution_log).
# Off by default; a Kafka outage never breaks an LLM call.
LLM_LOG_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
LLM_LOG_KAFKA_TOPIC_TEMPLATE=clariona.{tenant_id}.llm.execution.logs.v1

# ── Logging ────────────────────────────────────────────────────────────
# How much detail gets logged (DEBUG/INFO/WARNING/ERROR), and what file
# it's written to.
# Production: INFO is a good default. Only use DEBUG temporarily while
# actively troubleshooting — it's noisy.
LOG_LEVEL=INFO
LOG_FILE=avabodh.log

# ── Extra security hardening (all optional, all off/permissive by default) ─
# Which website addresses are allowed to call this API directly from a
# browser (CORS). "*" (default) allows any address — fine for
# server-to-server calls (which this rule doesn't even apply to), but
# permissive for a browser-facing setup.
# Production: set this to your actual frontend's address(es) if browsers
# will ever call this API directly.
CORS_ALLOWED_ORIGINS=*
# An extra password callers must send (as a header) in addition to the
# normal tenant identification, to prove they're allowed to call this
# API at all. Left blank, anything that can reach this server on the
# network can call it.
# Production: set this if this API is reachable from anywhere beyond a
# fully trusted internal network.
SERVICE_API_KEY=
# Blocks the website-scraping feature from targeting addresses on your
# own internal network (a safety guard against the scraper being tricked
# into probing your own infrastructure). Only turn this off if you have
# a specific, deliberate reason to scrape an internal address.
# Production: leave as false (the safe setting).
SCRAPER_ALLOW_PRIVATE_NETWORKS=false

# ── Optional: LangSmith call tracing/debugging ───────────────────────────
# Turns on detailed logging of every AI call to LangSmith (a third-party
# debugging dashboard), useful while developing but not needed to run
# the app.
# Production: leave off (false) unless you're actively debugging AI
# behavior and have a LangSmith account set up.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Avabodh Project

# ── /kb subsystem ─────────────────────────────────────────────────────────
# A separate, older feature (api/routes/kb.py) not touched by the search
# system this app uses today. Uses the same Postgres login as above; this
# is its own internal address setting.
# Production: fine to leave as-is.
PYTHON_KB_INTERNAL_URL=http://localhost:8000

# ── Optional: storing uploaded files in S3 instead of local disk ────────
# Leave STORAGE_S3_BUCKET blank to keep storing uploaded files on the
# server's own disk (the default — nothing changes). Set a bucket name to
# switch to storing them in Amazon S3 instead.
# Production: set this if you're running more than one copy of this app
# at once (multiple servers) — local disk storage isn't shared between
# them, so a document uploaded to one server wouldn't be visible from
# another without S3.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_KEY_PREFIX=avabodh/documents
# Only needed for an S3-compatible storage service that isn't actually
# Amazon (like MinIO). Leave blank for real AWS S3.
# Production: leave blank unless you're using a non-AWS S3-compatible
# service.
STORAGE_S3_ENDPOINT_URL=
# A safety-net cleanup timer, not a cache expiry. A locally-saved upload
# is normally deleted the moment it finishes processing; this only
# clears files left behind if the app crashed mid-job. Must be longer
# than your slowest real document takes to process, or you risk deleting
# a file while it's still being read.
# Production: fine to leave as-is unless you regularly process very
# large, slow documents.
STORAGE_LOCAL_TTL_HOURS=4
# Your AWS login credentials. Leave both blank and the app will instead
# use whatever AWS credentials are already available to the server
# itself (an IAM role, etc.) — the recommended approach for a real
# deployment rather than putting a key in a file.
# Production: leave blank; use IAM role or IAM role-based deployment
# credentials, not literal keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
